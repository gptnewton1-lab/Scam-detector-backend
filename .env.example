# Copy this file to .env and fill in real values.
# NEVER commit the real .env to git. This file is just a template.

# REQUIRED - generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Database connection string (SQLite default; use Postgres in production)
# DATABASE_URL=sqlite:///./database.db
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# Comma-separated list of allowed browser origins (your deployed Lovable URL)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Comma-separated allowed Host headers
ALLOWED_HOSTS=127.0.0.1,localhost

# Token lifetime (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# bcrypt cost factor
BCRYPT_ROUNDS=12

# Rate limiting
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_ANALYZE_RATE_LIMIT=10
